[web]
# System Operator web interface. Bind to a trusted LAN only when an external
# reverse proxy or management workstation must reach the service directly.
# host = "127.0.0.1"  # Use "" for IPv4+IPv6 or "::1" for IPv6 loopback.
# port = 8080
# admin_token = "change-me"

[public_web]
# enabled = true
# host = "127.0.0.1"  # Use "" for IPv4+IPv6 or "::1" for IPv6 loopback.
# port = 8081

